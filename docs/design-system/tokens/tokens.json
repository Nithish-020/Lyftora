{
  "$schema": "https://lyftora.dev/tokens/v1",
  "meta": {
    "name": "Lyftora Design Tokens",
    "version": "1.0.0",
    "description": "Standardized design tokens for Lyftora — AI Personal Trainer. 8px grid, strict scale.",
    "generated": "2026-04-12"
  },

  "colors": {
    "brand": {
      "background": "#0A0E1A",
      "primary": "#00D4AA",
      "secondary": "#7C6AF7",
      "warning": "#FFB020",
      "error": "#FF4D6A",
      "success": "#00D4AA"
    },
    "text": {
      "primary": "#FFFFFF",
      "secondary": "#A0A0B0",
      "tertiary": "#6B7280",
      "inverse": "#0A0E1A",
      "accent": "#00D4AA",
      "ai": "#7C6AF7"
    },
    "surface": {
      "base": "#0A0E1A",
      "low": "#111827",
      "container": "#1A2235",
      "high": "#243045",
      "highest": "#2E3A50"
    },
    "border": {
      "subtle": "rgba(255, 255, 255, 0.06)",
      "default": "rgba(255, 255, 255, 0.10)",
      "strong": "rgba(255, 255, 255, 0.16)",
      "accent": "rgba(0, 212, 170, 0.30)",
      "ai": "rgba(124, 106, 247, 0.30)"
    },
    "state": {
      "primaryHover": "#00BF99",
      "primaryPressed": "#00A886",
      "secondaryHover": "#6B5AE0",
      "secondaryPressed": "#5A4BC9"
    },
    "glass": {
      "background": "rgba(10, 14, 26, 0.80)",
      "blur": 12
    }
  },

  "typography": {
    "fonts": {
      "headline": "DM Sans",
      "body": "Inter",
      "label": "Space Grotesk",
      "mono": "JetBrains Mono"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "displayLg": { "size": 32, "lineHeight": 38, "weight": 700, "font": "headline", "letterSpacing": -0.5 },
      "displayMd": { "size": 28, "lineHeight": 34, "weight": 700, "font": "headline", "letterSpacing": -0.3 },
      "headlineLg": { "size": 24, "lineHeight": 30, "weight": 600, "font": "headline", "letterSpacing": -0.2 },
      "headlineMd": { "size": 20, "lineHeight": 26, "weight": 600, "font": "headline", "letterSpacing": 0 },
      "titleLg": { "size": 18, "lineHeight": 24, "weight": 600, "font": "body", "letterSpacing": 0 },
      "titleMd": { "size": 16, "lineHeight": 22, "weight": 600, "font": "body", "letterSpacing": 0 },
      "bodyLg": { "size": 16, "lineHeight": 24, "weight": 400, "font": "body", "letterSpacing": 0 },
      "bodyMd": { "size": 14, "lineHeight": 20, "weight": 400, "font": "body", "letterSpacing": 0 },
      "bodySm": { "size": 12, "lineHeight": 16, "weight": 400, "font": "body", "letterSpacing": 0 },
      "labelLg": { "size": 14, "lineHeight": 18, "weight": 500, "font": "label", "letterSpacing": 0.5 },
      "labelMd": { "size": 12, "lineHeight": 16, "weight": 500, "font": "label", "letterSpacing": 0.8 },
      "labelSm": { "size": 10, "lineHeight": 14, "weight": 500, "font": "label", "letterSpacing": 1.2 },
      "mono": { "size": 14, "lineHeight": 20, "weight": 700, "font": "mono", "letterSpacing": 0 }
    }
  },

  "spacing": {
    "_comment": "8px grid system. All values in px.",
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "screenPadding": 16,
    "cardPadding": 16,
    "sectionGap": 24,
    "cardGap": 12,
    "itemGap": 8
  },

  "radii": {
    "none": 0,
    "sm": 4,
    "default": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "full": 9999
  },

  "shadows": {
    "none": "none",
    "sm": { "offset": [0, 1], "blur": 3, "color": "rgba(0, 0, 0, 0.12)" },
    "md": { "offset": [0, 4], "blur": 12, "color": "rgba(0, 0, 0, 0.20)" },
    "lg": { "offset": [0, 8], "blur": 24, "color": "rgba(0, 0, 0, 0.25)" },
    "glow": { "offset": [0, 0], "blur": 16, "color": "rgba(0, 212, 170, 0.25)" },
    "navBar": { "offset": [0, -4], "blur": 20, "color": "rgba(0, 0, 0, 0.40)" }
  },

  "animation": {
    "fast": 100,
    "default": 200,
    "slow": 300,
    "spring": { "damping": 15, "stiffness": 150, "mass": 1 }
  },

  "touchTarget": {
    "minimum": 44,
    "comfortable": 48
  },

  "iconSize": {
    "sm": 16,
    "md": 20,
    "lg": 24,
    "xl": 32
  }
}
